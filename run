#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${PROJECT_DIR}/.env.local"

if [[ ! -f "${ENV_FILE}" ]]; then
    echo "Local configuration file ${ENV_FILE} does not exist." >&2
    echo "Copy .env.local.example to .env.local and fill in your database credentials." >&2
    exit 1
fi

set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a

: "${DATABASE_URL:?DATABASE_URL must be set in .env.local}"
: "${DATABASE_USERNAME:?DATABASE_USERNAME must be set in .env.local}"
: "${DATABASE_PASSWORD:?DATABASE_PASSWORD must be set in .env.local}"

export SERVER_PORT=8084

JVM_ARGUMENTS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5006"

cd "${PROJECT_DIR}"
exec ./mvnw spring-boot:run \
    -Dspring-boot.run.jvmArguments="${JVM_ARGUMENTS}"
